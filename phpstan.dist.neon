includes:
    - vendor/phpstan/phpstan-doctrine/extension.neon
    - vendor/phpstan/phpstan-doctrine/rules.neon
    - vendor/phpstan/phpstan-symfony/extension.neon
    - vendor/phpstan/phpstan-symfony/rules.neon
    - phpstan-baseline.neon

parameters:
    level: 6
    paths:
        - bin/
        - config/
        - public/
        - src/
        - packs/
        - controlroom/src/
    doctrine:
        # real Doctrine mapping: getRepository(X::class) -> custom repository class, DQL checked
        objectManagerLoader: config/phpstan/object-manager.php
        # entities use ?Type $x = null on NOT NULL columns (set before persist): not an error here
        allowNullablePropertyForRequiredField: true
    symfony:
        # controlroom container = site config + controlroom config (superset); warm it first:
        #   HTTP_HOST=<HOST_CONTROLROOM> bin/console cache:warmup
        containerXmlPath: var/cache/controlroom/dev/App_KernelDevDebugContainer.xml
