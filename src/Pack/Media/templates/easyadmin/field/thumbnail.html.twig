{% if field %}
{% set media = attribute(entity.instance, 'cover') ?? entity.instance is instanceof('App\Entity\Media') ? entity.instance : null %}

    {% if media %}
    
        {% if media.type.name == "IMAGE" %}
            <img
                src="{{ uploaded_asset(media)|imagine_filter('thumb_small') }}"
                class="thumbnail"
                width="200"
                height="200"
            />
        {% endif %}
        {% if media.type.name == "VIDEO" %}
            <img
                src="{{ asset('images/placeholder-video.png') }}"
                class="thumbnail"
                width="200"
                height="200"
                style="aspect-ratio: 1"
            />
        {% endif %}
    {% endif %}

{% else %}
    <span class="badge badge-outline">{{ 'label.null'|trans({}, 'EasyAdminBundle') }}</span>
{% endif %}
