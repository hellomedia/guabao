{
    "name": "hellomedia/guabao",
    "description": "Guabao Symfony Project",
    "autoload": {
        "psr-4": {
            "App\\": "src/",
            "Pack\\": "packs/",
            "Controlroom\\": "controlroom/src/"
        }
    },
    "require": {
        "php": "^8.5",
        "ext-ctype": "*",
        "ext-iconv": "*",
        "babdev/pagerfanta-bundle": "^4.5",
        "beberlei/doctrineextensions": "^1.5",
        "doctrine/dbal": "^4.0",
        "doctrine/doctrine-bundle": "^3.3",
        "doctrine/doctrine-fixtures-bundle": "^4.0",
        "doctrine/doctrine-migrations-bundle": "^4.0",
        "doctrine/orm": "^3.3",
        "easycorp/easyadmin-bundle": "^5.9",
        "geoip2/geoip2": "^3.3",
        "knplabs/knp-menu-bundle": "^3.1",
        "knplabs/knp-paginator-bundle": "^6.3",
        "knplabs/knp-time-bundle": "^2.4",
        "liip/imagine-bundle": "^2.13",
        "pagerfanta/doctrine-orm-adapter": "^4.7",
        "pagerfanta/twig": "^4.7",
        "sentry/sentry-symfony": "^5.1",
        "symfony/asset": "8.1.*",
        "symfony/asset-mapper": "8.1.*",
        "symfony/console": "8.1.*",
        "symfony/doctrine-messenger": "8.1.*",
        "symfony/dotenv": "8.1.*",
        "symfony/expression-language": "8.1.*",
        "symfony/flex": "^2.2",
        "symfony/form": "8.1.*",
        "symfony/framework-bundle": "8.1.*",
        "symfony/http-client": "8.1.*",
        "symfony/intl": "8.1.*",
        "symfony/lock": "8.1.*",
        "symfony/mailer": "8.1.*",
        "symfony/messenger": "8.1.*",
        "symfony/monolog-bundle": "^4.1",
        "symfony/postmark-mailer": "8.1.*",
        "symfony/property-access": "8.1.*",
        "symfony/property-info": "8.1.*",
        "symfony/rate-limiter": "8.1.*",
        "symfony/requirements-checker": "^2.0",
        "symfony/runtime": "8.1.*",
        "symfony/security-bundle": "8.1.*",
        "symfony/serializer": "8.1.*",
        "symfony/stimulus-bundle": "^3.7",
        "symfony/translation": "8.1.*",
        "symfony/twig-bundle": "8.1.*",
        "symfony/ux-autocomplete": "^3.7",
        "symfony/ux-chartjs": "^3.7",
        "symfony/ux-icons": "^3.7",
        "symfony/ux-live-component": "^3.7",
        "symfony/ux-turbo": "^3.7",
        "symfony/ux-twig-component": "^3.7",
        "symfony/validator": "8.1.*",
        "symfony/workflow": "8.1.*",
        "symfony/yaml": "8.1.*",
        "symfonycasts/dynamic-forms": "^0.2",
        "twig/extra-bundle": "^3.3",
        "twig/intl-extra": "^3.3",
        "twig/string-extra": "^3.3",
        "twig/twig": "^3.3",
        "vich/uploader-bundle": "^2.6",
        "zenstruck/foundry": "^2.2"
    },
    "minimum-stability": "stable",
    "require-dev": {
        "phpstan/phpdoc-parser": "^2.0",
        "phpstan/phpstan": "^2.3",
        "phpstan/phpstan-doctrine": "^2.0",
        "phpstan/phpstan-symfony": "^2.0",
        "rector/rector": "^2.8",
        "symfony/debug-bundle": "8.1.*",
        "symfony/maker-bundle": "^1.61",
        "symfony/stopwatch": "8.1.*",
        "symfony/var-dumper": "8.1.*",
        "symfony/web-profiler-bundle": "8.1.*"
    },
    "replace": {
        "paragonie/random_compat": "2.*",
        "symfony/polyfill-ctype": "*",
        "symfony/polyfill-iconv": "*",
        "symfony/polyfill-php71": "*",
        "symfony/polyfill-php70": "*",
        "symfony/polyfill-php56": "*"
    },
    "config": {
        "preferred-install": {
            "*": "dist"
        },
        "sort-packages": true,
        "allow-plugins": {
            "symfony/flex": true,
            "symfony/runtime": true,
            "php-http/discovery": true
        }
    },
    "scripts": {
        "auto-scripts": {
            "cache:clear": "symfony-cmd",
            "assets:install %PUBLIC_DIR%": "symfony-cmd",
            "requirements-checker": "script",
            "importmap:install": "symfony-cmd"
        },
        "post-install-cmd": [
            "@auto-scripts"
        ],
        "post-update-cmd": [
            "@auto-scripts"
        ]
    },
    "conflict": {
        "symfony/symfony": "*"
    },
    "extra": {
        "symfony": {
            "allow-contrib": true,
            "require": "8.1.*",
            "docker": true
        }
    }
}
