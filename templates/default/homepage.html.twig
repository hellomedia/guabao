{% extends 'layout/default.html.twig' %}

{# {% block title %}
	{{ 'Guabao'|trans }}
{% endblock %} #}

{% block body_extra_classes 'with-cards' %}

{% block content %}

<style>
    .homepage-section {
        margin: 30px 0;
    }
    .section-title {

    }
    .section-content {

    }
    .section-item {

    }
    .intro p {
        font-size: 18px;
        margin: 15px 0;
    }
</style>

    <div class="homepage-section intro">
        <div class="section-content">
            <p>Hello, my name is Nicolas.</p>
            <p>I am a slow traveler trying to find my place in this world.</p>
            <p>A human worried about what we are doing to each other and to our planet.<p>
            <p>
                This site is an attempt to share small things I find
                interesting or beautiful.
            </p>
        </div>
    </div>

    <div class="homepage-section">
        <h2 class="section-title">Slow Travel</h2>
        <div class="section-content">
            <div class="cards">
                {% for trip in top_slow_travel_trips %}
                    {% include 'trip/_card.html.twig' with {short_version: true} %}
                {% endfor %}
            </div>
        </div>
    </div>

    <div class="homepage-section">
        <h2 class="section-title">Hiking trips</h2>
        <div class="section-content">
            <div class="cards">
                {% for trip in top_hiking_trips %}
                    {% include 'trip/_card.html.twig' with {short_version: true} %}
                {% endfor %}
            </div>
        </div>
    </div>

    <div class="homepage-section">
        <h2 class="section-title">Adventures</h2>
        <div class="section-content">

            <div class="section-content">
                <div class="cards">
                    {% for story in top_adventures %}
                        {% include 'story/_card.html.twig' %}
                    {% endfor %}
                </div>
            </div>
        </div>
    </div>

    <div class="homepage-section">
        <h2 class="section-title">Discoveries</h2>
        <div class="section-content">

            <div class="section-content">
                <div class="cards">
                    {% for story in top_discoveries %}
                        {% include 'story/_card.html.twig' %}
                    {% endfor %}
                </div>
            </div>
        </div>
    </div>

    <div class="homepage-section">
        <h2 class="section-title">Historical places</h2>
        <div class="section-content">

            <div class="section-content">
                <div class="cards">
                    {% for story in top_historical_places %}
                        {% include 'story/_card.html.twig' %}
                    {% endfor %}
                </div>
            </div>
        </div>
    </div>
    <div class="homepage-section">
        <h2 class="section-title">Personal experiences</h2>
        <div class="section-content">

            <div class="section-content">
                <div class="cards">
                    {% for story in top_personal_experiences %}
                        {% include 'story/_card.html.twig' %}
                    {% endfor %}
                </div>
            </div>
        </div>
    </div>

    <div class="homepage-section">
        <h2 class="section-title">Food discoveries</h2>
        <div class="section-content">

            <div class="section-content">
                <div class="cards">
                    {% for food in top_food_discoveries %}
                        {% include 'food/_food_card.html.twig' with {
                            url: path('food_show', {slug: food.slug}) 
                        } %}
                    {% endfor %}
                </div>
            </div>
        </div>
    </div>
{% endblock %}
