{% extends 'layout/default.html.twig' %}

{% block body_extra_classes %}with-cards{% endblock %}

{% block content %}

    <style>
        .count {
            font-size: 16px;
        }
    </style>

	{% include 'food/_top_filters.html.twig' %}
	
	<div id="food-list" class="cards cards-menu">
		{% for item in tags_with_counts %}
			{% include 'food/tag/_card.html.twig' with {'tag': item.tag, 'food_count': item.food_count} %}
		{% endfor %}
	</div>

{% endblock %}

