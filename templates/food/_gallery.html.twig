<div data-controller="fancybox" class="gallery grid grid-cols-2 md:grid-cols-3 gap-4">

	{% for media in medias %}
		
		{% if media.isImage %}

            <a data-fancybox="gallery" href="{{ uploaded_asset(media) }}" data-caption="{{ media.description(app.request.locale) }}">
                <img 
                    src="{{ uploaded_asset(media)|imagine_filter('thumb_square_432') }}"
                    srcset="{{ uploaded_asset(media)|imagine_filter('thumb_square_432') }} 432w,
                        {{ uploaded_asset(media)|imagine_filter('thumb_square_640') }} 640w,
                        {{ uploaded_asset(media)|imagine_filter('thumb_square_864') }} 864w"
                    sizes="(max-width: 480px) 90vw, {# phone screen width minus margins #}
                        (min-width: 1200px) 207px, {# final grid item width with 6 columns #}
                        432px" {# default #}
                    class="rounded shadow-sm"
                    {# aspect-ratio set in CSS #}
                />
            </a>
		{% endif %}

	{% endfor %}
</div>

