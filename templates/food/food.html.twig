{% extends 'layout/default.html.twig' %}

{% block content %}

    {% for group in media_groups %}

        <h3>
            {% if group.type == 'meal' %}
                {{ group.meal }}
            {% else %}
                {{ group.date|format_date('long') }}
            {% endif %}
            --
            {% for placeTag in group.placeTags %}
                {{ placeTag|trans }}
            {% endfor %}
        </h3>

        {% include 'food/_gallery.html.twig' with {medias: group.medias } %}

	{% endfor %}

{% endblock %}

