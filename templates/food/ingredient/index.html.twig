{% extends 'layout/default.html.twig' %}

{% block body_extra_classes %}with-cards{% endblock %}

{% block content %}

    <style>
        .count {
            font-size: 16px;
        }
        .ingredient-weight-0 {
            color: var(--color-gray-400);  
        }
        .ingredient-weight-1 {
            color: var(--color-gray-500);  
        }
        .ingredient-weight-2 {
            color: var(--color-gray-600);
        }
        .ingredient-weight-3 {
            color: var(--color-gray-700);
        }
        .ingredient-weight-4 {
            color: var(--color-gray-800);
        }
        .ingredient-weight-5 {
            color: var(--color-gray-900);
        }
    </style>

	{% include 'food/_top_filters.html.twig' %}
	
    {% for food_type in food_types %}
        <h3 style="margin-bottom: 15px">{{ food_type.label }}</h3>
        <div class="cards cards-menu" style="margin-bottom: 20px">
            {% for item in food_type.items %}
                {% include 'food/ingredient/_card.html.twig' with {'ingredient': item.ingredient, 'food_count': item.food_count} %}
            {% endfor %}
        </div>
    {% endfor %}

{% endblock %}

