{% extends 'layout/default.html.twig' %}

{% block title %}
	{{ food }}
{% endblock %}

{% block content %}
	{% for media in food.medias %}
		<img
            src="{{ uploaded_asset(media)|imagine_filter('thumb_4_3_640') }}"
            srcset="{{ uploaded_asset(media)|imagine_filter('thumb_4_3_640') }} 640w,
                {{ uploaded_asset(media)|imagine_filter('thumb_4_3_1280') }} 1280w"
            sizes="640px"
			width="640"
			height="480"
		/>

		{% for tags in media.tags %}
			{{ tags|trans }}
		{% endfor %}

		<div>
			{{ media.takenAt|format('Y-m-D') }}
		</div>

		<div>
			{{ media.place }}
		</div>
	{% endfor %}

{% endblock %}
