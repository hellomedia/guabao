{% extends 'layout/default.html.twig' %}

{% block body_extra_classes %}food-page{% endblock %}


{% block content %}

    <style>
        .food-page {
            .media-group-title {
                width: 100%;
                background: lavender;
                padding: 20px 30px;
                border-radius: 5px;
                display: inline-flex;
                flex-direction: column;
                gap: 10px;
                margin-bottom: 20px;
                h3, h4 {
                    margin: 0;
                }
            }
            .date-location {
                display: flex;
                gap: 10px;
                justify-content: center;
                flex-direction: column;
                svg {
                    color: white;
                    width: 25px;
                    flex-shrink: 0;
                }
            }
            @media (width > 600px) {
                .media-group-title {
                    width: auto;
                }
                .date-location {
                    width: 100%;
                    flex-direction: row;
                    justify-content: space-between;
                    gap: 70px;
                    svg {
                        width: 30px;
                    }
                }
            }
            .date-location-date, 
            .date-location-location {
                display: flex;
                gap: 10px;
                align-items: center;
            }
            .gallery {
                margin-bottom: 20px;
            }
        }
    </style>

    <div id="rating">
        {% include 'food/_full_rating.html.twig' %}
    </div>

    <div id="tags" class="card-tags tags">
        {% for cuisine in food.cuisines %}
            <a class="tag food-tag"
                href="{{ path('food_cuisines_cuisine', {slugEn: cuisine.slugEn}) }}"
            >
                {{ cuisine|trans }}
            </a>
        {% endfor %}
        {% for tag in food.tags %}
            <a class="tag food-tag"
                href="{{ path('food_tags_tag', {slugEn: tag.slugEn}) }}"
            >
                {{ tag|trans }}
            </a>
        {% endfor %}
    </div>

    <div id="ingredients" class="card-tags tags">
        {% for ingredient in food.ingredients %}
            <a class="tag food-tag"
                href="{{ path('food_ingredients_ingredient', {slugEn: ingredient.slugEn}) }}"
            >
                {{ ingredient|trans }}
            </a>
        {% endfor %}
    </div>

    {% if food.similar is not empty %}
        <div id="similar-foods">
            <span class="similar-foods-title">Similar foods:</span>
            {% for similar_food in food.similar %}
                <span class="similar">
                    <a href="{{ path('food_show', {slug: similar_food.slug }) }}"/>{{ similar_food }}</a>
                </span>
                {{ not loop.last ? ', ' }}
            {% endfor %}
        </div>
    {% endif %}

    {% if food.description is not empty %}
        <div id="description">
            {{ food.description|nl2br }}
        </div>
    {% endif %}

    <div id="media-groups">
        {% for group in media_groups %}

            <div class="media-group-title">
                <h4 class="date-location">
                    <div class="date-location-date">
                        <twig:ux:icon name="calendar" />
                        <div>{{ group.date|format_date('long') }}</div>
                    </div>
                    <div class="date-location-location">
                        <twig:ux:icon name="location" />
                        <div>
                            {% for placeTag in group.placeTags[:1] %}
                                {{ placeTag|trans }}, {{ placeTag.country }}
                            {% endfor %}
                        </div>
                    </div>
                </h4>
                {% if group.type == 'meal' %}
                    <h3>{{ group.meal.name }}</h3>
                {% endif %}
            </div>
            

            {% include 'food/_gallery.html.twig' with {medias: group.medias } %}

        {% endfor %}
    </div>

{% endblock %}

