<div class="card card-food">
    {% set cover = food.cover %}
    {% if cover is not null %}
        <a href="{{ url }}" class="card-image-wrapper">
            <img 
                src="{{ uploaded_asset(cover)|imagine_filter('thumb_4_3_640') }}"
                srcset="{{ uploaded_asset(cover)|imagine_filter('thumb_4_3_640') }} 640w,
                    {{ uploaded_asset(cover)|imagine_filter('thumb_4_3_1280') }} 1280w"
                sizes="(max-width: 480px) 100vw,
                    (max-width: 900px) 50vw,
                    320px"
                width="800" {# keep 800x600. flex sizing depends on those values #}
                height="600"
            />
        </a>
    {% else %}
        <a href="{{ url }}" class="card-image-wrapper">
            {% include 'media/_placeholder_image.html.twig' %}
        </a>
    {% endif %}

    <div class="card-info">
        <h3 class="card-title">
            <a href="{{ url }}">
                {{ food|trans }}
            </a>
        </h3>

        <div class="card-bottom">
            <div class="card-ratings">
                {% include 'food/_rating.html.twig' %}
            </div>
            <div class="card-tags tags">
                {% for cuisine in food.cuisines %}
                    <span class="tag food-tag tag-{{ cuisine.slugEn }}">{{ cuisine|trans }}</span>
                {% else %}
                    <span class="tag food-tag tag-placeholder"></span>
                {% endfor %}
            </div>
        </div>

    </div>
</div>