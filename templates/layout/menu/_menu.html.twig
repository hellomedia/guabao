<nav
	id="main-menu"
	data-controller="menu-hover"
>

	<div class="default-container default-container-xpadding">
		<div class="main-menu-bar">
			<div class="main-menu-group">
				<div class="main-menu-logo">
					<a href="{{ path('homepage') }}">
						<img src="{{ asset('images/guabao-gua-light.svg') }}" class="main-menu-logo-light light-only" alt="Guabao Logo"/>
						<img src="{{ asset('images/guabao-gua-dark.svg') }}" class="main-menu-logo-dark dark-only" alt="Guabao Logo"/>
					</a>
				</div>
				<div id="main-menu-items">
					<a href="{{ path('trip_index') }}"
						class="main-menu-item {{ app.current_route starts with 'trip' or app.current_route starts with 'child_trip' ? 'current' }}"
						data-action="mouseenter->menu-hover#enter mouseleave->menu-hover#leave">
						{{ 'Trips'|trans }}
					</a>
					<a href="{{ path('food_index') }}"
						class="main-menu-item {{ app.current_route starts with 'food' ? 'current' }}"
						data-action="mouseenter->menu-hover#enter mouseleave->menu-hover#leave">
						{{ 'Food'|trans }}
					</a>
				</div>

			</div>

			<div class="main-menu-group">
                {% set show_language_switcher = (exclude_language_switcher ?? false) == false %}
                {% if show_language_switcher %}
                    <div class="main-menu-language">
                        {% include "layout/menu/_language_switcher.html.twig" %}
                    </div>
                {% endif %}

				{# <div class="main-menu-language">
					{% include "layout/menu/_theme_switcher.html.twig" %}
				</div> #}

				<div
					class="main-menu-mobile"
					data-controller="mobile-menu"
				>
					{% include "layout/menu/_mobile_menu_button.html.twig" with {
						mobile_menu_button_extra_classes: 'main-menu-mobile-button',
						mobile_menu_button_svg_classes: 'main-menu-mobile-button-icon'
					} %}
					{% include "layout/menu/_mobile_menu.html.twig" %}
					{% include 'layout/menu/_bottom_menu.html.twig' %}
				</div>
			</div>
		</div>
	</div>

</nav>
