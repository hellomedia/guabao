<div class="card card-trip">
    {% if trip.cover %}
        <a href="{{ path(trip) }}" class="card-image-wrapper">
            {% set image = trip.cover %}
            <img
                class="card-image"
                src="{{ uploaded_asset(image)|imagine_filter('thumb_4_3_640') }}"
                srcset="{{ uploaded_asset(image)|imagine_filter('thumb_4_3_640') }} 640w,
                    {{ uploaded_asset(image)|imagine_filter('thumb_4_3_1280') }} 1280w"
                sizes="(max-width: 480px) 100vw,
                    (max-width: 900px) 50vw,
                    320px"
                width="800" {# keep 800x600. flex sizing depends on those values #}
                height="600"
            />
        </a>
    {% else %}
        <a href="{{ path(trip) }}" class="card-image-wrapper">
            {% include 'media/_placeholder_image.html.twig' %}
        </a>
    {% endif %}

    <div class="card-info">
        <h3 class="card-title">
            <a href="{{ path(trip) }}">
                {{ trip|trans }}
            </a>
        </h3>

        <div class="card-info-bottom">

            <div class="card-period">
                {{ trip.period }}   
            </div>

            <div class="card-duration">
                {{ trip|tripDuration }}   
            </div>

            {% if (short_version ?? false) == false %}
                <div class="card-bottom">
                    <div class="card-ratings">
                        {% include 'trip/_rating.html.twig' %}
                    </div>
                    <div class="card-tags tags">
                        {% for tag in trip.tags %}
                            {% if tag.nameEn == 'Slow travel' %}
                                <a 
                                    href="{{ path('trip_index_slow_travel') }}"
                                    class="tag trip-tag tag-{{ tag.slugEn|lower }}"
                                >
                                    {{ tag|trans }}
                                </a>
                            {% endif %}
                            {% if tag.nameEn == 'Hiking trip' %}
                                <a
                                    href="{{ path('trip_index_hiking') }}"
                                    class="tag trip-tag tag-{{ tag.slugEn|lower }}"
                                >
                                    {{ tag|trans }}
                                </a>
                            {% endif %}
                        {% endfor %}
                    </div>
                </div>
            {% endif %}
        </div>

    </div>
</div>
