{% include 'trip/_trip_overview_menu.html.twig' %}

<div id="rating">
	{% include 'trip/_rating.html.twig' %}
</div>

<div id="description">
    {{ trip.description(app.locale)|nl2br }}
</div>

<div id="trips" class="cards cards-horizontal cards-trip-legs">
	{% for childTrip in trip.children %}
		{% include 'trip/_card.html.twig' with {trip: childTrip} %}
        {% if not loop.last %}
            <div class="trip-leg-separator">
                <span>·</span>
                <span>·</span>
                <span>·</span>
            </div>
        {% endif %}
	{% endfor %}
</div>
