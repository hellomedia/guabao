{% extends 'layout/default.html.twig' %}

{% block body_extra_classes %}with-cards{% endblock %}

{% block content %}
	
    {% set currentPath = path(app.request.attributes.get('_route'), app.request.attributes.get('_route_params')) %}

    {% set currentSort = app.request.query.has('s') ? app.request.query.get('s') : 'd' %}

    <div id="top-filters">
        <a 
            href="{{ path('trip_index') }}"
            class="{{ app.current_route == 'trip_index' ? 'current' }}"
        >
            {{ 'All trips'|trans }}
        </a>
        <a 
            href="{{ path('trip_index_slow_travel') }}"
            class="{{ app.current_route == 'trip_index_slow_travel' ? 'current' }}"
        >
            {{ 'Slow travel'|trans }}
        </a>
        <a 
            href="{{ path('trip_index_hiking') }}"
            class="{{ app.current_route == 'trip_index_hiking' ? 'current' }}"
        >
            {{ 'Hiking trips'|trans }}
        </a>

        <div class="order">
            <twig:ux:icon name="sort" style="display: inline; height: 33px; margin-right: 7px; margin-top: -9px; margin-bottom: -9px" />
            <a href="{{ currentPath ~ '?s=d' }}" class="{{ currentSort == 'd' ? 'current' }}">🗓️</a>
            <a href="{{ currentPath ~ '?s=u' }}" class="{{ currentSort == 'u' ? 'current' }}">⏳</a>
            <a href="{{ currentPath ~ '?s=i' }}" class="{{ currentSort == 'i' ? 'current' }}">🔥</a>
            <a href="{{ currentPath ~ '?s=a' }}" class="{{ currentSort == 'a' ? 'current' }}">✨</a>
        </div>
    </div>

    <div id="trips" class="cards cards-horizontal">
        {% for trip in trips %}
            {% include 'trip/_card.html.twig' %}
        {% endfor %}
    </div>

{% endblock %}
