{% include 'trip/_top_filters_child_trip.html.twig' %}

{% if trip.description(app.locale) is not empty %}
    <div id="description">
        {{ trip.description(app.locale)|nl2br }}
    </div>
{% endif %}

<div id="rating">
	{% include 'trip/_rating.html.twig' %}
</div>

{# {% if trip.cover %}
	<div id="cover">
		<img src="{{ uploaded_asset(trip.cover)|imagine_filter('thumb_large') }}"
            width="{{ trip.cover.width }}"
            height="{{ trip.cover.height }}"
        />
	</div>
{% endif %} #}

{% if trip.stories is not empty %}
    <div id="stories">
        {% for story in trip.stories %}
            <div class="story">
                <h2>{{ story }}</h2>
                <div class="story-description">
                    {{ story.description(app.locale)|nl2br }}
                </div>
                <div class="story-medias">
                    {% include "trip/_gallery.html.twig" with {
                        medias: story.medias,
                        gallery: 'story' ~ story.id
                    } %}
                </div>
            </div>
        {% endfor %}
    </div>
{% endif %}


