{% include 'trip/_top_filters_child_trip.html.twig' %}

{% if trip.cover %}
    <div id="cover">
        <img
            src="{{ uploaded_asset(trip.cover)|imagine_filter('thumb_large') }}"
            width="{{ trip.cover.width }}"
            height="{{ trip.cover.height }}"
        />
    </div>
{% endif %}

<div id="rating">
    {% include 'trip/_rating.html.twig' %}
</div>

{% if trip.description(app.locale) is not empty %}
    <div id="description">
        {{ trip.description(app.locale)|nl2br }}
    </div>
{% endif %}

{% if trip.highlight is not empty %}
    <div id="highlights">
        {% for highlight in trip.highlights %}
            <img 
                src="{{ uploaded_asset(highlight)|imagine_filter('thumb_card') }}"
                width="700"
                height="700"
            />
        {% endfor %}
    </div>
{% endif %}

{% include "trip/_gallery.html.twig" %}

