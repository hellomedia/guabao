{% set parentTrip = trip.parentTrip %}

<div id="top-filters"
    class="multi-trip invisible-scroll"
    data-controller="restore-x-scroll"
    data-restore-x-scroll-key-value="trip-{{ parentTrip.id }}" 
>
	<a href="{{ path(parentTrip) }}" style="margin-right: 10px">
        <span class="trip-name">{{ parentTrip.shortNameWithFallback(app.locale) }}</span>
        <span class="trip-duration">{{ parentTrip|tripDuration }}</span>
	</a>

	{% for childTrip in trip.parentTrip.childTrips %}
		<a href="{{ path(childTrip) }}" class="trip-leg {{ childTrip == trip ? 'current' }}">
            <span class="trip-name">{{ childTrip|trans }}</span>
            <span class="trip-duration">{{ childTrip|tripDuration }}</span>
		</a>
        {% if not loop.last %}
            <span class="trip-leg-divider"></span>
        {% endif %}
	{% endfor %}

</div>

<div id="top-filters">
	<a href="{{ path(trip) }}" class="{{ app.current_route in ['trip_show'] ? 'current' }}">
		{{ 'Overview'|trans }}
	</a>
	<a href="{{ path('trip_gallery', {slug: trip.slug(app.locale)}) }}" class="{{ app.current_route == 'trip_gallery' ? 'current' }}">
		{{ 'Gallery'|trans }}
	</a>
</div>




