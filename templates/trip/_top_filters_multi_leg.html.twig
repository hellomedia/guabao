<div id="top-filters"
    class="multi-trip invisible-scroll"
    data-controller="restore-x-scroll"
    data-restore-x-scroll-key-value="trip-{{ trip.id }}" 
>
	<a href="{{ path(trip) }}" class="current" style="margin-right: 10px">
		{{ trip.shortName(app.locale) }}
	</a>
    {% for childTrip in trip.childTrips %}
        <a href="{{ path(childTrip) }}" class="trip-leg">
            <span class="trip-leg-name">{{ childTrip|trans }}</span>
            <span class="trip-leg-duration">{{ childTrip|tripDuration }}</span>
        </a>
        {% if not loop.last %}
            <span class="trip-leg-divider"></span>
        {% endif %}
    {% endfor %}
</div>

