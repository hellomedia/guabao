<div id="top-filters"
    class="multi-trip invisible-scroll"
    data-controller="restore-x-scroll"
    data-restore-x-scroll-key-value="trip-{{ trip.id }}" 
>
	<a href="{{ path(trip) }}" class="top-level-trip current" style="margin-right: 10px">
        <span class="trip-name">{{ trip.shortNameWithFallback(app.locale) }}</span>
        <span class="trip-duration">{{ trip|tripDuration }}</span>
	</a>
    {% for childTrip in trip.children %}
        <a href="{{ path(childTrip) }}" class="trip-leg">
            <span class="trip-name">{{ childTrip|trans }}</span>
            <span class="trip-duration">{{ childTrip|tripDuration }}</span>
        </a>
        {% if not loop.last %}
            <span class="trip-leg-divider"></span>
        {% endif %}
    {% endfor %}
</div>

