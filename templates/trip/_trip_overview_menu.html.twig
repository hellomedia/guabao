{% set parent = trip.parent ?? trip %}

<div
    class="trip-overview-menu multi-trip invisible-scroll {{ position ?? 'top' }}"
    data-controller="restore-x-scroll"
    data-restore-x-scroll-key-value="trip-{{ parent.id }}" 
>
	<a href="{{ path(parent) }}" class="top-level-trip {{ trip == parent ? 'current' }}" style="margin-right: 10px">
        <span class="trip-name">{{ parent.shortNameWithFallback(app.locale) }}</span>
        <span class="trip-duration">{{ parent|tripDuration }}</span>
	</a>

	{% for childTrip in parent.children %}
		<a href="{{ path(childTrip) }}" class="trip-leg {{ trip == childTrip ? 'current' }}">
            <span class="trip-name">{{ childTrip|trans }}</span>
            <span class="trip-duration">{{ childTrip|tripDuration }}</span>
		</a>
        {% if not loop.last %}
            <span class="trip-leg-divider"></span>
        {% endif %}
	{% endfor %}

</div>




