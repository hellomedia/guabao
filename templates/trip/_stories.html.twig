{% if stories is not empty %}
    <style>
        .story-video {
            margin-top: 100px;
            margin-bottom: 100px;
        }
    </style>
	<div id="stories">
		{% for story in stories %}
            {% if story.display %}
                <div class="story {{ not story.showTitle ? 'no-title' }}">
                    {% if story.showTitle %}
                        <h2>{{ story }}</h2>
                    {% endif %}
                    {% if story.description is not empty %}
                        <div class="story-description">
                            {{ story.description(app.locale)|nl2br }}
                        </div>
                    {% endif %}
                    {% set video = story.displayablePrimaryVideo %}
                    {% if video %}
                        <div class="story-video">
                            {% include "media/_video.html.twig" %}
                        </div>
                    {% endif %}
                    {% if story.displayableImages is not empty %}
                        <div class="story-images story-image-count-{{ story.displayableImages|length }}">
                            {% include "trip/_gallery.html.twig" with {
                                medias: story.displayableImages,
                                gallery: 'story' ~ story.id
                            } %}
                        </div>
                    {% endif %}
                    {% if story.textBelowGallery is not empty %}
                        <div class="story-description">
                            {{ story.textBelowGallery(app.locale)|nl2br }}
                        </div>
                    {% endif %}
                    {% if story.displayable360s is not empty %}
                        <div class="story-360s story-360-count-{{ story.displayable360s|length }}">
                            {% include "trip/_pano360s.html.twig" with {
                                pano360s: story.displayable360s,
                                gallery: 'story' ~ story.id ~ '-360'
                            } %}
                        </div>
                    {% endif %}
                    {% for video in story.displayableSecondaryVideos %}
                        <div class="story-video">
                            {% include "media/_video.html.twig" %}
                        </div>
                    {% endfor %}
                </div>
            {% endif %}
		{% endfor %}
	</div>
{% endif %}