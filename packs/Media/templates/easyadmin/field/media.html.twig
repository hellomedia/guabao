{% if field %}

    {% set media = attribute(entity.instance, 'cover') ?? (entity.instance is instanceof('App\\Entity\\Media') ? entity.instance : null) %}

    {% if media %}
        <div class="thumb-versions">
            <img
                src="{{ uploaded_asset(media)|imagine_filter('thumb_large') }}"
                class="thumb-large"
                width="{{ media.width }}"
                height="{{ media.height }}"
            />
            <img
                src="{{ uploaded_asset(media)|imagine_filter('thumb_4_3_1280') }}"
                class="thumb-card"
                width="1280"
                height="920"
            />
            <img
                src="{{ uploaded_asset(media)|imagine_filter('thumb_4_3_640') }}"
                class="thumb-card"
                width="640"
                height="480"
            />
            <img
                src="{{ uploaded_asset(media)|imagine_filter('thumb_square_864') }}"
                class="thumb-card"
                width="864"
                height="864"
            />
            <img
                src="{{ uploaded_asset(media)|imagine_filter('thumb_square_432') }}"
                class="thumb-card"
                width="432"
                height="432"
            />
            <img
                src="{{ uploaded_asset(media)|imagine_filter('thumb_square_432') }}"
                class="thumb-small"
                width="200"
                height="200"
            />
        </div>
    {% endif %}

{% else %}
    <span class="badge badge-outline">{{ 'label.null'|trans({}, 'EasyAdminBundle') }}</span>
{% endif %}
