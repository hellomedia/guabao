# define your env variables for the test env here
KERNEL_CLASS='App\Kernel'
APP_SECRET='$ecretf0rt3st'

# Hosts of the two kernels (site, controlroom), with .test names: requests never leave the
# process, but generated URLs (emails) should not look like dev or prod.
HOST="guabao.test"
HOST_CONTROLROOM="admin.guabao.test"
# Never send emails from tests: .env ends with an empty Postmark MAILER_DSN.
MAILER_DSN=null://null

# DATABASE_URL goes in .env.test.local (git-ignored), like .env.local for dev.
# Doctrine appends "_test" to the database name (when@test dbname_suffix in doctrine.yaml).
