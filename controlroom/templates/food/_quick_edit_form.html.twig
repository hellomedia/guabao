{# Important: Note the syntax with [] and only #}
{# Ignore global themes; use only EasyAdmin #}
{# important to avoid theme conflicts #}
{% form_theme form with ['@controlroom/form/form_theme.html.twig'] only %}

<div id="food_{{ food.id }}" data-controller="ajax">

    <form
        name="food_quick_edit_form_{{ food.id }}"
        data-ajax-target="form"
        data-action="submit->ajax#submit"
        action="{{ path('admin_food_quick_edit', {id: food.id}) }}"
        method="post"
        style="margin-bottom: 20px"
    >

        {# container for form content replaced in ajax #}
        <div data-ajax-target="container" class="quick-edit-item-grid">
            
            <div class="column-1">
                {{ form_row(form.nameEn) }}
                {{ form_row(form.nameFr) }}
                {{ form_row(form.tags) }}
            </div>

            <div class="column-2">
                {{ form_row(form.cuisine) }}
                {{ form_row(form.cuisines) }}
                {{ form_row(form.ingredients) }}
            </div>

            <div class="column-3">
                {{ form_row(form.loveLevel) }}
                {{ form_row(form.healthyLevel) }}
                {{ form_row(form.localLevel) }}
            </div>

            {{ form_rest(form) }}
        
        </div>

        {% include '@controlroom/form/_ajax_button.html.twig' %}

    </form>

</div>

