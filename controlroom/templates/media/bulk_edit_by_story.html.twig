{% extends '@EasyAdmin/page/content.html.twig' %}

{% block content_title %}
    Story: {{ story }}
{% endblock %}

{% block page_actions %}
	{% embed '@controlroom/_top_links.html.twig' %}
		{% block add_pictures %}
			<a class="btn" href="{{ path('admin_media_bulk_add', {'story': story.id}) }}">
				+ Pictures
			</a>
		{% endblock %}
	{% endembed %}
{% endblock %}

{% block head_stylesheets %}
    {{ parent() }}
    <style>
        #trip, #story, #medias {
            margin-bottom: 40px;
        }
        #story, #bulk-edit {
            border: 1px solid lightgray;
            padding: 30px;
        }
        #bulk-edit {
            margin-bottom: 60px;
        }
        #trip {
            margin-top: 15px;
            font-size: 18px;
        }
    </style>
{% endblock %}

{% block main %}
    <div id="trip">
        Trip: <a href="{{ path('admin_media_bulk_edit_by_trip', { id: story.trip.id }) }}">{{ story.trip }}</a>
    </div>

    <div id="story">
        <h3>{{ story }}</h3>
        {% include "@controlroom/story/_quick_edit_form.html.twig" with { form: story_form, story: story } %}
    </div>

    <div id="bulk-edit">
        <p style="margin-top: 10px; margin-bottom: 20px">
            Add or remove tags for all medias in this story
        </p>
        <div class="quick-edit-2rows">
            <div class="column-1">
                {% include '@controlroom/media/_bulk_add_tags_form.html.twig' with { form: bulk_add_tags_form } %}
            </div>
            <div class="column-2">
                {% include '@controlroom/media/_bulk_remove_tags_form.html.twig' with { form: bulk_remove_tags_form } %}
            </div>
        </div>
    </div>

    <div id="medias" data-controller="fancybox">
        {% for media in medias %}
            {% include '@controlroom/media/_quick_edit_form.html.twig'
                with { form: forms[media.id] }
            %}
            <hr style="margin-top: 40px; margin-bottom: 30px;">
        {% endfor %}
    </div>

{% endblock %}

{% block javascript %}
    {{ parent() }}
{% endblock %}

