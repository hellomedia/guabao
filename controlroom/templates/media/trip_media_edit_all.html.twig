{% extends '@EasyAdmin/page/content.html.twig' %}

{% block content_title %}Edit Medias for {{ trip }}{% endblock %}

{% block page_actions %}
    <a class="btn" href="{{ path('admin_media_add_multiple') }}">
        Add pictures
    </a>
    <a class="btn" href="{{ path('controlroom_media_new') }}">
        Add videos
    </a>
    <a class="btn" href="{{ path('controlroom_trip_index') }}">
        Trips
    </a>
    <a class="btn" href="{{ path('controlroom_story_index') }}">
        Stories
    </a>
    <a class="btn" href="{{ path('controlroom_media_tag_index') }}">
        Tags
    </a>
    <a class="btn" href="{{ path('controlroom_place_index') }}">
        Places
    </a>
    <a class="btn" href="{{ path('controlroom_place_tag_index') }}">
        Place tags
    </a>
    <a class="btn" href="{{ path('controlroom_food_index') }}">
        Food
    </a>
    <a class="btn" href="{{ path('controlroom_cuisine_index') }}">
        Cuisine
    </a>
    <a class="btn" href="{{ path('controlroom_ingredient_index') }}">
        Ingredients
    </a>
{% endblock %}


{% block main %}

    <style>
        .spinner-wrapper {
            position: absolute;
            top: 0;
            bottom: 0;
            left: 0;
            right: 0;
            display: flex;
            justify-content: center;
            align-items: center;
        }
        .spinner {
            width: 22px; height: 22px;
            border: 3px solid currentColor;
            border-right-color: transparent;
            border-radius: 9999px;
            animation: spin .6s linear infinite;
        }
        @keyframes spin { to { transform: rotate(360deg); } }
        .hidden { display: none; }
    </style>
    
    <br/>

    {% for media in medias %}
        {% include '@controlroom/media/_trip_media_edit_form.html.twig'
            with { form: forms[media.id] }
        %}
        <hr style="margin-top: 40px; margin-bottom: 30px;">
    {% endfor %}

{% endblock %}

{% block javascript %}
    {{ parent() }}
{% endblock %}

    

