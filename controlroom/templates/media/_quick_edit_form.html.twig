{# Important: Note the syntax with [] and only #}
{# Ignore global themes; use only EasyAdmin #}
{# important to avoid theme conflicts #}
{% form_theme form with ['@admin/form/form_theme.html.twig'] only %}

<style>
    .thumb-side {
        display:flex;
        flex-direction:column;
        gap: 2px;
        .form-group {
            padding: 0;
        }
    }
</style>
<div id="media_{{ media.id }}">

    <form
        name="media_quick_edit_form_{{ media.id }}"
        action="{{ path('admin_media_quick_edit', {id: media.id}) }}"
        method="post"
        style="margin-bottom: 20px"
        data-controller="ajax"
        data-action="submit->ajax#submit change->ajax#submitOnChange"
    >

        {# container for form content replaced in ajax #}
        <div data-ajax-target="container" class="quick-edit">

            <div class="column-1">
    
                <div style="display:flex;gap:15px;align-items:start">

                    <div style="display:flex;flex-direction:column;gap:10px;">
                        <a data-fancybox="quick-edit-gallery"
                            href="{{ uploaded_asset(media) }}" 
                            data-caption="{{ media.description(app.request.locale)|nl2br }}"
                        >
                            {% if media.isImage %}
                                <img    
                                    style="height: 220px; width: auto;margin-bottom: 15px;" 
                                    src="{{ uploaded_asset(media)|imagine_filter('thumb_small') }}"
                                    width="300"
                                    height="300"
                                    class="{{ media.story is not null and not media.showInStory ? 'faded' }}"
                                />
                            {% endif %}

                            {% if media.isVideo %}
                                {% if media.orientation == enum('App\\Enum\\VideoOrientation').LANDSCAPE %}
                                    <div style="padding:56.25% 0 0 0;position:relative;width:280px;">
                                        <iframe src="https://player.vimeo.com/video/{{ media.vimeoId }}?badge=0&amp;autopause=0&amp;player_id=0&amp;app_id=58479" frameborder="0" allow="autoplay; fullscreen; picture-in-picture; clipboard-write; encrypted-media; web-share" referrerpolicy="strict-origin-when-cross-origin" style="position:absolute;top:0;left:0;width:100%;height:100%;" title="VID_20170815_180837"></iframe>
                                    </div>
                                {% endif %}

                                {% if media.orientation == enum('App\\Enum\\VideoOrientation').PORTRAIT %}
                                    <div style="padding:177.78% 0 0 0;position:relative;width:200px;">
                                        <iframe src="https://player.vimeo.com/video/{{ media.vimeoId }}?badge=0&amp;autopause=0&amp;player_id=0&amp;app_id=58479" frameborder="0" allow="autoplay; fullscreen; picture-in-picture; clipboard-write; encrypted-media; web-share" referrerpolicy="strict-origin-when-cross-origin" style="position:absolute;top:0;left:0;width:100%;height:100%;" title=""></iframe>
                                    </div>
                                {% endif %}

                            {% endif %}
                        </a>

                        {% if media.isImage %}
                            <a target="_blank" style="margin-bottom: 3px" href="{{ path('controlroom_image_detail', {'entityId': media.id}) }}">
                                See details
                            </a>
                        {% endif %}
                        {% if media.isVideo %}
                            <a target="_blank" style="margin-bottom: 3px" href="{{ path('controlroom_video_detail', {'entityId': media.id}) }}">
                                See details
                            </a>
                        {% endif %}

                    </div>

                    <div class="thumb-side">   
                        {{ form_row(form.size2) }}
                        {{ form_row(form.size3) }}
                        {{ form_row(form.isPano) }}
                        {{ form_row(form.is360) }}
                        {{ form_row(form.isPrimaryVideo) }}
                    </div>

                </div>

                {{ form_row(form.descriptionEn) }}
                {{ form_row(form.descriptionFr) }}
                {{ form_row(form.tags) }}
            </div>

            <div class="column-2">
                {{ form_row(form.trip) }}
                {{ form_row(form.isTripCover) }}
                {{ form_row(form.showInTrip) }}

                {{ form_row(form.story) }}
                {{ form_row(form.showInStory) }}
                
                {{ form_row(form.placeTags) }}
                {{ form_row(form.place) }}

            </div>

            <div class="column-3">
                {{ form_row(form.food) }}
                {{ form_row(form.showInFood) }}
                {{ form_row(form.meal) }}
                {{ form_row(form.isMeal) }}
                {{ form_row(form.takenAt) }}
                {{ form_row(form.siteHighlights) }}
            </div>

            {{ form_rest(form) }}

        
        </div>

        {% include '@admin/form/_ajax_button.html.twig' %}

    </form>

</div>

