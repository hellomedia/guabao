{# Important: Note the syntax with [] and only #}
{# Ignore global themes; use only EasyAdmin #}
{# important to avoid theme conflicts #}
{% form_theme form with ['@EasyAdmin/crud/form_theme.html.twig'] only %}

<div id="media_{{ media.id }}" data-controller="trip-media-edit-form" data-trip-media-edit-form-target="container">

    <form
		name="trip_media_edit_form_{{ media.id }}"
        data-trip-media-edit-form-target="form"
        data-action="submit->trip-media-edit-form#submit"
        action="{{ path('admin_trip_media_edit', {id: media.id}) }}"
        method="post"
        style="margin-bottom: 20px"
    >
        <img
            style="height: 300px; width: auto;" 
            src="{{ uploaded_asset(media)|imagine_filter('thumb_card_square') }}"
        />
        <div style="margin-top: 15px; margin-bottom: 10px">
            {{ form_row(form.descriptionEn) }}
            {{ form_row(form.descriptionFr) }}
        </div>
        
		{{ form_rest(form) }}

        <button type="submit" style="margin-top: 30px; padding: 10px 40px;font-size: 16px;" class="btn btn-primary btn-lg">Save</button>
    </form>
</div>

