{% extends '@EasyAdmin/page/content.html.twig' %}

{% block content_title %}
    Trip: {{ trip }}
{% endblock %}


{% block page_actions %}
    {% include '@controlroom/_top_links.html.twig' %}
{% endblock %}

{% block head_stylesheets %}
    {{ parent() }}
	<style>
		#parent, #children, #stories, #gallery {
			margin-bottom: 40px;
		}
        #parent, #children {
            font-size: 18px;
        }
        #children-list {
            display: flex;
            flex-direction: row;
            gap: 5px;

        }
        .sortable-item {
            border: 0;
            padding: 0;
        }
        .story-medias {
            display: flex;
            flex-wrap: wrap;
            gap: 5px;
            img {
                width: 150px;
                height: auto;
            }
        }
        hr {
            margin-top: 40px;
            margin-bottom: 30px;
        }
	</style>
{% endblock %}

{% block main %}

{% if trip.parent %}
    <div id="parent">
        Parent:
        <a href="{{ path('admin_media_bulk_edit_by_trip', {id: trip.parent.id}) }}">{{ trip.parent }}</a>
    </div>
{% endif %}

{% if trip.children is not empty %}
    <div id="children">
        Children:
        {% for child in trip.children %}
            <div id="children-list">
                <a href="{{ path('admin_media_bulk_edit_by_trip', {id: child.id}) }}">{{ child }}</a>
            </div>
        {% endfor %}
    </div>
{% endif %}

    <h3>Stories</h3>

    <div id="stories">

        <ul class="sortable" style="margin-top: 20px;padding-left: 0;{# bootstrap css override needed because of css layers #}"
            data-controller="sortable"
            data-sortable-url-value="{{ path('admin_story_reorder') }}"
            data-sortable-param-value="story_ids"
            data-sortable-animation-value="150"
        >
            {% for story in trip.stories %}
                <li class="sortable-item" data-id="{{ story.id }}">
                    <svg style="width:25px" fill="none" stroke="currentColor" viewbox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 8h16M4 16h16"></path>
                    </svg>
                    <div>
                        <h5>{{ story }}</h5>
                        <a href="{{ path('admin_media_bulk_edit_by_story', { id: story.id}) }}">
                            <div class="story-medias">
                                {% for media in story.medias %}
                                    <img src="{{ uploaded_asset(media)|imagine_filter('thumb_small') }}" alt="" width="200" height="200"/>
                                {% endfor %}
                            </div>
                        </a>
                    </div>
                </li>
            {% endfor %} 
        </ul>

    </div>

    <h3>Gallery</h3>

    <p style="margin-top: 15px; margin-bottom: 30px">
        Note: Medias who do not belong to a story or have
        <code>in_default_gallery = true</code>
    </p>

    <div id="gallery" 
        data-controller="infinite-scroll"
        data-infinite-scroll-next-page-url-value="{{ pager.hasNextPage ? path('admin_media_bulk_edit_by_trip', { id: trip.id, page: pager.nextPage }) }}"
    >
        <div class="current-page">
            {% for media in pager %}
                {% include '@controlroom/media/_quick_edit_form.html.twig'
                    with { form: forms[media.id] }
                %}
                <hr>
            {% endfor %}

            {% if not pager.hasNextPage %}
                <div data-infinite-scroll-end style="display:none"></div>
            {% endif %}
        </div>

        <div class="next-page" data-infinite-scroll-target="nextPage">
        </div>

    </div>

{% endblock %}

{% block javascript %}
    {{ parent() }}
{% endblock %}

    

