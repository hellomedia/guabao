{% extends '@admin/base.html.twig' %}

{% block content_title %}Dashboard{% endblock %}

{% block main %}

<style>
    #shortcuts {
        max-width: 500px;
        margin-inline: auto;
        display: flex;
        flex-direction: column;
        align-items: center;
    }
    .btn-group-lg {
        margin-top: 50px;
        display: flex;
        gap: 20px
    }
    #notable-visitors {
        margin-top: 80px;
        table {
            margin-bottom: 30px;
        }
    }
</style>

<div id="shortcuts">
    <div class="btn-group-lg">
        <a class="btn btn-lg" href="{{ path('admin_media_bulk_add') }}">
            Add images
        </a>
        <a class="btn btn-lg" href="{{ path('controlroom_video_new') }}">
            Add video
        </a>
    </div>
    <div class="btn-group-lg">
        <a class="btn btn-lg" href="{{ path('controlroom_trip_index') }}">
            Trips
        </a>

        <a class="btn btn-lg" href="{{ path('controlroom_story_index') }}">
            Stories
        </a>

        <a class="btn btn-lg" href="{{ path('controlroom_media_tag_index') }}">
            Tags
        </a>
    </div>
    <div class="btn-group-lg">
        <a class="btn btn-lg" href="{{ path('controlroom_place_index') }}">
            Places
        </a>

        <a class="btn btn-lg" href="{{ path('controlroom_place_tag_index') }}">
            Place tags
        </a>
    </div>

    <div class="btn-group-lg">
        <a class="btn btn-lg" href="{{ path('controlroom_food_index') }}">
            Food
        </a>

        <a class="btn btn-lg" href="{{ path('controlroom_cuisine_index') }}">
            Cuisine
        </a>

        <a class="btn btn-lg" href="{{ path('controlroom_ingredient_index') }}">
            Ingredients
        </a>
    </div>
</div>

<div id="notable-visitors">
    <a href="{{ path('controlroom_anonymous_visitor_index') }}"><h3>Last seen visitors</h3></a>
    <table  class="table datagrid">
        <tr>
            <th>Id</th>
            <th>Last seen</th>
            <th>Visitor Id</th>
            <th>Alias</th>
            <th>Pages</th>
            <th>Visits</th>
            <th>Countries</th>
            <th>Cities</th>
            <th>First seen</th>
        </tr>
        {% for visitor in notable_visitors_by_last_seen %}
            <tr>
                <td>{{ visitor.id }}</td>
                <td>{{ visitor.lastSeenAt|date('d-m-y H:i') }}</td>
                <td><a href="{{ path('controlroom_anonymous_visitor_detail', {entityId: visitor.id}) }}">{{ visitor.visitorId }}</a></td>
                <td>{{ visitor.alias }}</td>
                <td>{{ visitor.pageCount }}</td>
                <td>{{ visitor.visitCount }}</td>
                <td>{{ visitor.countryNamesAsString }}</td>
                <td>{{ visitor.citiesAsString }}</td>
                <td>{{ visitor.firstSeenAt|date('d-m-y H:i')}}</td>
            </tr>
        {% endfor %}
    </table>

    <a href="{{ path('controlroom_anonymous_visitor_index') }}"><h3>Most page counts visitors</h3></a>
    <table  class="table datagrid">
        <tr>
            <th>Id</th>
            <th>Pages</th>
            <th>Visitor Id</th>
            <th>Alias</th>
            <th>Visits</th>
            <th>Countries</th>
            <th>Cities</th>
            <th>Last seen</th>
            <th>First seen</th>
        </tr>
        {% for visitor in notable_visitors_by_page_count %}
            <tr>
                <td>{{ visitor.id }}</td>
                <td>{{ visitor.pageCount }}</td>
                <td><a href="{{ path('controlroom_anonymous_visitor_detail', {entityId: visitor.id}) }}">{{ visitor.visitorId }}</a></td>
                <td>{{ visitor.alias }}</td>
                <td>{{ visitor.visitCount }}</td>
                <td>{{ visitor.countryNamesAsString }}</td>
                <td>{{ visitor.citiesAsString }}</td>
                <td>{{ visitor.lastSeenAt|date('d-m-y H:i') }}</td>
                <td>{{ visitor.firstSeenAt|date('d-m-y H:i') }}</td>
            </tr>
        {% endfor %}
    </table>
</div>

{% endblock %}