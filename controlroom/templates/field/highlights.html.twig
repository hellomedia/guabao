<div class="entity-list">
	{% if field.value|length > 0 %}
        {% for highlight in field.value %}
            <a href="{{ path('controlroom_highlight_detail', {entityId: highlight.id}) }}">
                {{ highlight }}
            </a>
        {% endfor %}
    {% else %}
        <span class="badge badge-outline">{{ 'label.null'|trans({}, 'EasyAdminBundle') }}</span>
    {% endif %}
</div>

