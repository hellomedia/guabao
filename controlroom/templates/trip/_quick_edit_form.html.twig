{# Important: Note the syntax with [] and only #}
{# Ignore global themes; use only EasyAdmin #}
{# important to avoid theme conflicts #}
{% form_theme form with ['@controlroom/form/form_theme.html.twig'] only %}

<div id="trip_{{ trip.id }}" data-controller="ajax">

    <form
        name="trip_quick_edit_form_{{ trip.id }}"
        data-ajax-target="form"
        data-action="submit->ajax#submit change->ajax#submitOnChange"
        action="{{ path('admin_trip_quick_edit', {id: trip.id}) }}"
        method="post"
        style="margin-bottom: 20px"
    >

        {# container for form content replaced in ajax #}
        <div data-ajax-target="container" class="quick-edit-2rows">
            
            <div class="column-1">

                {{ form_row(form.nameEn) }}
                {{ form_row(form.descriptionEn) }}
                {{ form_row(form.tags) }}
            </div>
            <div class="column-1">
                {{ form_row(form.nameFr) }}
                {{ form_row(form.descriptionFr) }}
                {{ form_row(form.countries) }}
                {{ form_rest(form) }}
            </div>
        
        </div>

        {% include '@controlroom/form/_ajax_button.html.twig' %}

    </form>

</div>

